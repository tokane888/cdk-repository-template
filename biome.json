{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!cdk.context.json",
      "!cdk.json",
      "!cdk.out",
      "!.cspell.jsonc",
      "!dist",
      "!docs",
      "!dprint.json",
      "!jest.config.mjs",
      "!package-lock.json",
      "!tsconfig.json"
    ]
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedImports": "error"
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
