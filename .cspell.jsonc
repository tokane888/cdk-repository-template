{
  "ignorePaths": [
    // vscode拡張名, libの名前等固有名詞が多いファイルはspell check対象から除外
    ".devcontainer/devcontainer.json",
    ".devcontainer/Dockerfile",
    "cdk.json",
    "cdk.out",
    "docs",
    "dprint.json",
  ],
  // 単語登録
  "words": [
    "installsuffix",
    "omopj",
  ],
  "ignoreRegExpList": [
    "[０-９Ａ-Ｚａ-ｚぁ-んァ-ヶ亜-熙纊-黑]+", // 日本語に対してspell checkが正常に機能しないのでcheck対象から除外
  ],
}
